{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private Talk",
  "version": "0.1.0",
  "identifier": "com.privatetalk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Private Talk",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: privatetalk-media:; media-src 'self' blob: privatetalk-media:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* https://*.supabase.co wss://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
